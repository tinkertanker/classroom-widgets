# Match at every depth: pnpm creates a node_modules (symlink farm + .bin shims)
# in every workspace package, not just the root.
**/node_modules
.pnp
.pnp.js
npm-debug.log
.git
.gitignore
README.md
**/.env
**/.env.*
**/.dev.vars
!**/.env.example
!**/.env.production.example
**/.DS_Store
coverage
.nyc_output
dist
packages/macos-dashboard/.build
packages/student/vite.config.js
*.tsbuildinfo
secrets
**/secrets
src/secrets
.playwright-cli
.repopromt
.clawpatch
.wrangler
# Cloudflare deploy tooling (its staged teacher build, wrangler state); no
# image copies it.
deploy
**/xcuserdata
output/playwright
.vscode
.idea
**/*.log
docker-compose*.yml
Dockerfile*
.dockerignore
packages/teacher/build
packages/server/public/student
# Demo videos and their render pipelines (media/) never ship in an image; keep
# them out of the build context too. See media/display-widget-demo/README.md.
media
