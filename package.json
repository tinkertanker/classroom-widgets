{
  "name": "classroom-widgets",
  "version": "0.10.11",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/teacher",
    "packages/student",
    "packages/server",
    "services/studio-api"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:teacher": "npm run dev -w @classroom-widgets/teacher",
    "dev:server": "npm run dev -w @classroom-widgets/server",
    "dev:student": "npm run dev -w @classroom-widgets/student",
    "dev:studio-api": "npm run dev -w @classroom-widgets/studio-api",
    "dev:studio": "npm run dev:studio-api",
    "dev:all": "concurrently -n teacher,server,student -c blue,green,magenta \"npm run dev:teacher\" \"npm run dev:server\" \"npm run dev:student\"",
    "dev:concurrent": "npm run dev:all",
    "build": "npm run build --workspaces --if-present",
    "build:student": "npm run build -w @classroom-widgets/student",
    "build:all": "npm run build",
    "test": "npm run test -w @classroom-widgets/teacher",
    "test:studio": "npm run test:studio-class-code && node --test scripts/studio-html-seeds.test.mjs evals/model/artifact-eval.test.mjs && npm run test -w @classroom-widgets/studio-api",
    "test:studio-class-code": "node --test scripts/studio-class-code.test.mjs",
    "verify:studio": "npm run test:studio && npm run typecheck -w @classroom-widgets/studio-api && npm run studio:seeds:validate && npm run eval:artifacts && npm run verify:studio-resources",
    "verify:studio-resources": "tsx scripts/verify-studio-ipad-resources.ts",
    "studio:seeds:package": "node scripts/studio-html-seeds.mjs package",
    "studio:seeds:validate": "node scripts/studio-html-seeds.mjs validate",
    "studio:seeds:import": "node scripts/studio-html-seeds.mjs import",
    "eval:artifacts": "tsx evals/artifacts/run.ts",
    "eval:model": "tsx evals/model/run.ts",
    "eval:model-moderation": "tsx evals/model/moderation.ts",
    "verify:studio-live": "tsx scripts/verify-studio-live.ts",
    "provision:studio-class": "node scripts/provision-studio-class-code.mjs",
    "test:build-config": "node scripts/check-root-build-config.cjs",
    "generate:voice-types": "node scripts/generateVoiceCommandTypes.cjs",
    "prebuild": "npm run generate:voice-types",
    "macos:run": "./script/build_and_run.sh",
    "macos:dmg": "./script/build_macos_release.sh",
    "ipad:generate": "cd apps/ipad && xcodegen generate",
    "ipad:prepare": "node scripts/sync-studio-examples-to-ipad.mjs && npm run ipad:generate",
    "server": "npm run start -w @classroom-widgets/server",
    "install:all": "npm install",
    "clean": "node scripts/clean-workspaces.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
