{
  "name": "classroom-widgets",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:teacher": "pnpm --filter @classroom-widgets/teacher dev",
    "dev:server": "pnpm --filter @classroom-widgets/server dev",
    "dev:student": "pnpm --filter @classroom-widgets/student dev",
    "dev:all": "concurrently -n teacher,server,student -c blue,green,magenta \"pnpm dev:teacher\" \"pnpm dev:server\" \"pnpm dev:student\"",
    "dev:concurrent": "pnpm dev:all",
    "build": "pnpm --recursive --if-present build",
    "build:student": "pnpm --filter @classroom-widgets/student build",
    "build:all": "pnpm run build",
    "test": "pnpm --filter @classroom-widgets/teacher test",
    "test:build-config": "node scripts/check-root-build-config.cjs",
    "generate:voice-types": "node scripts/generateVoiceCommandTypes.cjs",
    "prebuild": "pnpm generate:voice-types",
    "macos:run": "./scripts/build_and_run.sh",
    "macos:dmg": "./scripts/build_macos_release.sh",
    "windows:run": "powershell -ExecutionPolicy Bypass -File ./scripts/build_windows.ps1",
    "windows:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/build_windows.ps1 -Publish -NoRun",
    "linux:run": "./scripts/build_linux.sh",
    "linux:publish": "./scripts/build_linux.sh --publish --no-run",
    "server": "pnpm --filter @classroom-widgets/server start",
    "install:all": "pnpm install",
    "clean": "node scripts/clean-workspaces.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
