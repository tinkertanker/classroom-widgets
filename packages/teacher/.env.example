# Classroom Widgets - Teacher App Development Environment
# Copy to packages/teacher/.env for local Vite development.

# Backend server URL used by the teacher app for API and Socket.IO connections.
VITE_SERVER_URL=http://localhost:3001

# Show the web Link Shortener widget (Short.io key lives on the backend, see packages/server/.env.example)
VITE_LINK_SHORTENER_ENABLED=false

# Umami Analytics (optional)
VITE_UMAMI_SCRIPT_URL=http://localhost:3003/script.js
VITE_UMAMI_WEBSITE_ID=

# Enable debug mode (optional)
# VITE_DEBUG=true
