<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClassroomWidgets</AssemblyName>
    <RootNamespace>ClassroomWidgets</RootNamespace>
    <Product>Classroom Widgets</Product>
    <Company>Tinkertanker</Company>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/version.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <!-- Windows Forms is only used for the tray icon and screen enumeration; keep its types out of implicit usings. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Source\App.xaml" />
    <Page Remove="Source\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <None Include="version.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundle the teacher production build so the app runs without a dev server. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../teacher/build/index.html')">
    <None Include="../teacher/build/**/*" Link="Web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
