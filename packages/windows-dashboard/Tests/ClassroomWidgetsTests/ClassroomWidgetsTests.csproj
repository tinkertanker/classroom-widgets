<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Source\DashboardSettings.cs" Link="DashboardSettings.cs" />
    <Compile Include="..\..\Source\WidgetPanelModels.cs" Link="WidgetPanelModels.cs" />
    <Compile Include="..\..\Source\DashboardShortenerSettings.cs" Link="DashboardShortenerSettings.cs" />
    <Compile Include="..\..\Source\DashboardLog.cs" Link="DashboardLog.cs" />
    <Compile Include="..\..\Source\UpdateVersion.cs" Link="UpdateVersion.cs" />
    <Compile Include="..\..\Source\WindowsInstallation.cs" Link="WindowsInstallation.cs" />
    <Compile Include="..\..\Source\DisplayGeometry.cs" Link="DisplayGeometry.cs" />
    <Compile Include="..\..\Source\DisplayCatalog.cs" Link="DisplayCatalog.cs" />
    <Compile Include="..\..\Source\DisplayShortcutLogic.cs" Link="DisplayShortcutLogic.cs" />
  </ItemGroup>

</Project>
