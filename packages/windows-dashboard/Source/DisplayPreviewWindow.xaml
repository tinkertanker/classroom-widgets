<Window x:Class="ClassroomWidgets.DisplayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="Black"
        MinWidth="320"
        MinHeight="282"
        UseLayoutRounding="True">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Grid x:Name="PreviewSurface"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
              Cursor="Cross">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />
        </Grid>
        <Border Grid.Row="1" Background="#DD202020">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PowerButton" Grid.Column="0" Content="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="PowerButton_Click" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="White" TextTrimming="CharacterEllipsis" />
                <Button x:Name="LayoutButton" Grid.Column="2"
                        ToolTip="Position and size" AutomationProperties.Name="Position and size"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="LayoutButton_Click">
                    <Grid Width="16" Height="13">
                        <Rectangle Stroke="White" StrokeThickness="1" RadiusX="1.5" RadiusY="1.5" />
                        <Rectangle Fill="White" Width="6" Margin="2.5,2.5,0,2.5" HorizontalAlignment="Left" />
                    </Grid>
                </Button>
                <Button x:Name="MenuButton" Grid.Column="3" Content="⋯" FontSize="20"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="MenuButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
