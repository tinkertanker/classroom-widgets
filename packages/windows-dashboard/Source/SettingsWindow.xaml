<Window x:Class="ClassroomWidgets.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classroom Widgets Settings"
        Width="820"
        Height="680"
        MinWidth="720"
        MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#F5F5F7"
        FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock Text="Widgets" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

        <CheckBox x:Name="AlwaysOnTopCheck" Content="Keep widgets above other windows" Margin="0,4"
                  Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed" />

        <CheckBox x:Name="LaunchAtLoginCheck" Content="Launch at login" Margin="0,4"
                  Checked="LaunchAtLoginCheck_Changed" Unchecked="LaunchAtLoginCheck_Changed" />

        <TextBlock Text="Background opacity" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="OpacitySlider_ValueChanged" />
            <TextBlock x:Name="OpacityLabel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"
                   Text="Lower the opacity to let slides or other windows show through the widgets." />

        <TextBlock Text="Link Shortener" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,8" />

        <ComboBox x:Name="ProviderCombo" Margin="0,4" SelectionChanged="ProviderCombo_SelectionChanged">
            <ComboBoxItem Content="TinyURL — no sign-up" Tag="tinyurl" />
            <ComboBoxItem Content="spoo.me — no sign-up" Tag="spoo" />
            <ComboBoxItem Content="Short.io — your branded domain" Tag="shortio" />
        </ComboBox>

        <StackPanel x:Name="ShortioFields" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock Text="Public API key (pk_…)" Margin="0,4,0,2" />
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
            <TextBlock Text="Domain (e.g. go.myschool.edu)" Margin="0,8,0,2" />
            <TextBox x:Name="DomainBox" TextChanged="DomainBox_TextChanged" />
            <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"
                       Text="Use a public key, never a secret API key." />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"
                   Text="These settings are saved on this PC and shared by all Link Shortener and QR Code widgets. Creating a short link sends its destination to the selected provider; if your school blocks a shortening domain, try another service." />

        <Separator Margin="0,18,0,14" />
        <TextBlock Text="Widget launch shortcuts" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,0,0,12"
                   Text="When Show and Dismiss match, the shortcut toggles the widget. Make them different to let Show create additional widgets." />
        <StackPanel x:Name="ShortcutRows" />
        <TextBlock x:Name="ShortcutLoadingLabel" Text="Loading widgets…" Foreground="#6B7280" FontSize="12" />

        <Button x:Name="ResetPositionsButton" Content="Forget saved widget positions" Margin="0,18,0,0" Padding="10,4"
                HorizontalAlignment="Left" Click="ResetPositionsButton_Click" />

        <TextBlock x:Name="VersionLabel" Margin="0,18,0,0" Foreground="#6B7280" FontSize="12" />
    </StackPanel>
    </ScrollViewer>
</Window>
